POCHI_SEED_DEMO=true

# Path database absolut. Default: <project>/data/pochi.db
# POCHI_DB_PATH=/home/user/Projects/pochi-gateway/data/pochi.db

# Origin frontend yang diizinkan (format JSON).
# POCHI_CORS_ORIGINS=["http://127.0.0.1:5173"]

# Admin token. Jika kosong, dibuat otomatis di data/admin_token (mode 600).
# POCHI_ADMIN_TOKEN=ganti-dengan-token-panjang-acak
# POCHI_ADMIN_TOKEN_PATH=/home/user/Projects/pochi-gateway/data/admin_token

# Kunci enkripsi provider secret. Dibuat otomatis saat provider pertama disimpan.
# POCHI_SECRET_KEY_PATH=/home/user/Projects/pochi-gateway/data/secret.key

# Izinkan base_url provider menunjuk ke jaringan privat/loopback.
# true = mode lokal (9Router di 127.0.0.1). Set false sebelum dipublikasikan.
# POCHI_ALLOW_PRIVATE_PROVIDER_URLS=true

# Batas waktu uji koneksi provider dalam detik.
# POCHI_PROVIDER_TIMEOUT_SECONDS=8

# Batas waktu gateway saat memanggil provider.
# POCHI_GATEWAY_TIMEOUT_SECONDS=120
# POCHI_GATEWAY_CONNECT_TIMEOUT_SECONDS=10

# Batas request per menit per virtual key. 0 menonaktifkan rate limit.
# POCHI_GATEWAY_RATE_LIMIT_RPM=60

# Scheduler workflow (trigger.schedule) berjalan di proses API.
# POCHI_WORKFLOW_SCHEDULER_ENABLED=true
